{
  "name": "wpbuild",
  "version": "0.1.0",
  "description": "A fast, modern, and extensible build system for WordPress.",
  "type": "module",
  "main": "lib/cjs/index.d.cts",
  "module": "lib/esm/index.d.ts",
  "types": "lib/cjs/index.d.cts",
  "bin": "lib/cli/cli.js",
  "exports": {
    "./cli": {
      "import": "./lib/cli/cli.js"
    },
    ".": {
      "import": {
        "types": "./lib/esm/index.d.ts",
        "default": "./lib/esm/index.js"
      },
      "require": {
        "types": "./lib/cjs/index.d.cts",
        "default": "./lib/cjs/index.cjs"
      }
    }
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "build": "tsc",
    "dev": "pnpm build && node lib/index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codevault-llc/wpbuild.git"
  },
  "author": "@lukasolsen",
  "license": "MIT OR Apache-2.0",
  "bugs": {
    "url": "https://github.com/codevault-llc/wpbuild/issues"
  },
  "homepage": "https://github.com/codevault-llc/wpbuild#readme",
  "dependencies": {
    "execa": "^8.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.1",
    "@types/node": "^18.11.18",
    "@typescript-eslint/eslint-plugin": "^5.48.0",
    "@typescript-eslint/parser": "^5.48.0",
    "eslint": "^8.31.0",
    "tsup": "^8.4.0",
    "typescript": "^4.9.4",
    "typescript-eslint": "^8.31.1"
  },
  "optionalDependencies": {
    "wpbuild-darwin-arm64": "0.1.0",
    "wpbuild-darwin-x64": "0.1.0",
    "wpbuild-linux-arm64": "0.1.0",
    "wpbuild-linux-x64": "0.1.0",
    "wpbuild-windows-arm64": "0.1.0",
    "wpbuild-windows-x64": "0.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
